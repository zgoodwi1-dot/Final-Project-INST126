import random
import pandas as pd

# Setup
print("WELCOME TO MY NAASII GAME")

total_rounds = 4

# Choose a number 1-12 set it aside

name_1 = input("Player 1 Name: ")
name_2 = input("Player 2 Name: ")

score_1 = 0
score_2 = 0

 for round_number in range(1, total_rounds + 1):
    print("\nROUND " + str(round_number) + " START")
    
    # Player 1 rolls 
    input(name_1 + ", press Enter to roll!")
    
    # Dice roll function 
    roll1 = random.randint(1, 12)
    roll2 = random.randint(1, 12)
    roll3 = random.randint(1, 12)
    roll4 = random.randint(1, 12)
    
    print("Rolls: ", roll1, roll2, roll3, roll4)

    
    # Roll output for player 1
    score_1 = score_1 + roll1 + roll2 + roll3 + roll4
    
    print(name_1 + "'s Total Score: " + str(score_1))

# Player 2 rolls
    input("\n" + name_2 + ", press Enter to roll!")
    
    roll1 = random.randint(1, 12)
    roll2 = random.randint(1, 12)
    roll3 = random.randint(1, 12)
    roll4 = random.randint(1, 12)

    print("Rolls: ", roll1, roll2, roll3, roll4)
    
    # player 2s score 
    score_2 = score_2 + roll1 + roll2 + roll3 + roll4
    
    print(name_2 + "'s Total Score: " + str(score_2))

# Final score output
print("\nGAME OVER!:")

# Final scores for player 1 and 2
game_data = {
    "Players": [name_1, name_2],
    "Final Scores": [score_1, score_2]
}

# Implementing pandas to clean up if statements 
df = pd.DataFrame(game_data)

print(df) 

# Calculate who won 
if score_1 > score_2:
    print(name_1, "WINS!")
    
if score_2 > score_1:
    print(name_2, "WINS!")

if score_1 == score_2:
    print("IT IS A TIE!")
